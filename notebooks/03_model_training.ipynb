    "!pip install -q grad-cam\n",
    "\n",
    "from pytorch_grad_cam import GradCAM\n",
    "from pytorch_grad_cam.utils.image import show_cam_on_image\n",
    "from pytorch_grad_cam.utils.model_targets import ClassifierOutputTarget\n",
    "import numpy as np\n",
    "\n",
    "# Target layer — last conv block of EfficientNet\n",
    "target_layer = [model.backbone.conv_head]\n",
    "\n",
    "cam = GradCAM(model=model, target_layers=target_layer)\n",
    "\n",
    "# Get a batch of test images\n",
    "images_batch, labels_batch = next(iter(test_loader))\n",
    "images_batch = images_batch[:8].to(device)\n",
    "\n",
    "fig, axes = plt.subplots(2, 8, figsize=(20, 6))\n",
    "\n",
    "for i in range(8):\n",
    "    img_tensor = images_batch[i:i+1]\n",
    "    label      = labels_batch[i].item()\n",
    "\n",
    "    # Generate Grad-CAM\n",
    "    targets   = [ClassifierOutputTarget(label)]\n",
    "    grayscale = cam(input_tensor=img_tensor, targets=targets)\n",
    "\n",
    "    # Denormalize image for display\n",
    "    img_np = denormalize(images_batch[i]).permute(1, 2, 0).cpu().numpy()\n",
    "    img_np = np.clip(img_np, 0, 1).astype(np.float32)\n",
    "\n",
    "    cam_image = show_cam_on_image(img_np, grayscale[0], use_rgb=True)\n",
    "\n",
    "    # Original\n",
    "    axes[0, i].imshow(img_np)\n",
    "    axes[0, i].set_title(CONFIG['class_names'][label], fontsize=7)\n",
    "    axes[0, i].axis('off')\n",
    "\n",
    "    # Grad-CAM\n",
    "    axes[1, i].imshow(cam_image)\n",
    "    axes[1, i].set_title('Grad-CAM', fontsize=7)\n",
    "    axes[1, i].axis('off')\n",
    "\n",
    "axes[0, 0].set_ylabel('Original', fontsize=9, rotation=90)\n",
    "axes[1, 0].set_ylabel('Grad-CAM', fontsize=9, rotation=90)\n",
    "\n",
    "fig.suptitle('Grad-CAM Heatmaps — Model Attention Visualization',\n",
    "             fontsize=12, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.savefig(f'{SAVE_DIR}/gradcam_preview.png', dpi=120, bbox_inches='tight')\n",
    "plt.show()\n",
