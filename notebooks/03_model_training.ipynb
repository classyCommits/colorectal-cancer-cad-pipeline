    "## Cell 4 — Configuration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "\n",
    "# ── Training Configuration ─────────────────────────────────────────\n",
    "CONFIG = {\n",
    "    # Dataset\n",
    "    'dataset_name'    : '1aurent/LC25000',\n",
    "    'n_per_class'     : 5000,      # 5000 per class = 10000 total\n",
    "    'train_ratio'     : 0.70,\n",
    "    'val_ratio'       : 0.15,\n",
    "    # test = remaining 0.15\n",
    "\n",
    "    # Model\n",
    "    'model_name'      : 'efficientnet_b0',\n",
    "    'num_classes'     : 2,\n",
    "    'pretrained'      : True,\n",
    "    'image_size'      : 224,\n",
    "\n",
    "    # Training\n",
    "    'epochs'          : 15,\n",
    "    'batch_size'      : 32,\n",
    "    'learning_rate'   : 1e-4,\n",
    "    'weight_decay'    : 1e-4,\n",
    "    'patience'        : 5,         # early stopping patience\n",
    "\n",
    "    # Classes\n",
    "    'class_names'     : ['colon_aca', 'colon_n'],\n",
    "    'class_labels'    : {'colon_aca': 0, 'colon_n': 1},\n",
    "\n",
    "    # Device\n",
    "    'device'          : 'cuda' if torch.cuda.is_available() else 'cpu',\n",
    "\n",
    "    # Paths\n",
    "    'save_dir'        : SAVE_DIR,\n",
    "    'model_filename'  : 'efficientnet_b0_colon.pth',\n",
    "}\n",
    "\n",
    "print('Configuration:')\n",
    "for k, v in CONFIG.items():\n",
    "    print(f'  {k:20s}: {v}')"
   ]
