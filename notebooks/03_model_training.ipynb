    "    ax.set_title(class_names[label], fontsize=8,\n",
    "                 color='red' if label == 0 else 'green')\n",
    "    ax.axis('off')\n",
    "\n",
    "fig.suptitle('Sample Training Patches\\nRed=Cancer (colon_aca)  Green=Normal (colon_n)',\n",
    "             fontsize=12, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.savefig(f'{SAVE_DIR}/sample_patches.png', dpi=100, bbox_inches='tight')\n",
