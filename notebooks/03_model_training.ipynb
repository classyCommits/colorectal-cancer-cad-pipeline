  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 5 — Load Dataset from HuggingFace"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from datasets import load_dataset\n",
    "from collections import defaultdict\n",
    "from PIL import Image\n",
    "import numpy as np\n",
    "\n",
    "print('Loading LC25000 dataset from HuggingFace...')\n",
    "print('(Streaming — no full download needed)')\n",
    "\n",
    "# Load full dataset\n",
    "ds = load_dataset('1aurent/LC25000', split='train', trust_remote_code=True)\n",
    "print(f'Total images in dataset: {len(ds)}')\n",
    "print(f'Features: {ds.features}')\n",
    "\n",
    "# Filter to only colon classes\n",
    "# Label mapping varies by dataset version — let's inspect first\n",
    "print('\\nUnique labels:', set(ds['label'][:100]))\n",
    "print('Label names:', ds.features['label'].names if hasattr(ds.features['label'], 'names') else 'N/A')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Extract colon subset\n",
    "# LC25000 has 5 classes: colon_aca, colon_n, lung_aca, lung_n, lung_scc\n",
    "# We only want colon classes\n",
    "\n",
    "label_names = ds.features['label'].names\n",
    "print('All label names:', label_names)\n",
    "\n",
    "colon_aca_idx = label_names.index('colon_aca')\n",
    "colon_n_idx   = label_names.index('colon_n')\n",
    "print(f'colon_aca index: {colon_aca_idx}')\n",
    "print(f'colon_n   index: {colon_n_idx}')\n",
    "\n",
    "# Filter dataset to colon classes only\n",
    "colon_ds = ds.filter(\n",
    "    lambda x: x['label'] in [colon_aca_idx, colon_n_idx],\n",
    "    num_proc=2\n",
    ")\n",
    "print(f'\\nColon subset size: {len(colon_ds)}')\n",
    "\n",
    "# Remap labels to 0 and 1\n",
    "def remap_labels(example):\n",
    "    example['label'] = 0 if example['label'] == colon_aca_idx else 1\n",
    "    return example\n",
    "\n",
    "colon_ds = colon_ds.map(remap_labels)\n",
    "print('Labels remapped: colon_aca=0, colon_n=1')\n",
    "\n",
    "# Verify distribution\n",
    "from collections import Counter\n",
    "label_counts = Counter(colon_ds['label'])\n",
    "print(f'Class distribution: {dict(label_counts)}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 6 — Train/Val/Test Split"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "# Get all indices\n",
    "indices = list(range(len(colon_ds)))\n",
    "labels  = colon_ds['label']\n",
    "\n",
    "# Stratified split — ensures equal class distribution across splits\n",
    "train_idx, temp_idx = train_test_split(\n",
    "    indices,\n",
    "    test_size=1 - CONFIG['train_ratio'],\n",
    "    stratify=labels,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "temp_labels = [labels[i] for i in temp_idx]\n",
    "val_ratio_adjusted = CONFIG['val_ratio'] / (1 - CONFIG['train_ratio'])\n",
    "\n",
    "val_idx, test_idx = train_test_split(\n",
    "    temp_idx,\n",
    "    test_size=1 - val_ratio_adjusted,\n",
    "    stratify=temp_labels,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "print(f'Train : {len(train_idx):5d} images')\n",
    "print(f'Val   : {len(val_idx):5d} images')\n",
    "print(f'Test  : {len(test_idx):5d} images')\n",
    "print(f'Total : {len(train_idx)+len(val_idx)+len(test_idx):5d} images')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 7 — PyTorch Dataset & DataLoaders"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "from torchvision import transforms\n",
    "\n",
    "# ── Transforms ────────────────────────────────────────────────────\n",
    "# ImageNet normalization values (standard for pretrained models)\n",
    "IMAGENET_MEAN = [0.485, 0.456, 0.406]\n",
    "IMAGENET_STD  = [0.229, 0.224, 0.225]\n",
    "\n",
    "train_transform = transforms.Compose([\n",
    "    transforms.Resize((CONFIG['image_size'], CONFIG['image_size'])),\n",
    "    transforms.RandomHorizontalFlip(p=0.5),\n",
    "    transforms.RandomVerticalFlip(p=0.5),\n",
    "    transforms.RandomRotation(degrees=90),\n",
    "    transforms.ColorJitter(\n",
    "        brightness=0.2,\n",
    "        contrast=0.2,\n",
    "        saturation=0.1,\n",
    "        hue=0.05\n",
    "    ),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=IMAGENET_MEAN, std=IMAGENET_STD),\n",
    "])\n",
    "\n",
    "val_transform = transforms.Compose([\n",
    "    transforms.Resize((CONFIG['image_size'], CONFIG['image_size'])),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=IMAGENET_MEAN, std=IMAGENET_STD),\n",
    "])\n",
    "\n",
    "\n",
    "# ── Dataset Class ─────────────────────────────────────────────────\n",
    "class ColonDataset(Dataset):\n",
    "    \"\"\"\n",
    "    PyTorch Dataset wrapping the HuggingFace colon subset.\n",
    "\n",
    "    Args:\n",
    "        hf_dataset : HuggingFace dataset object\n",
    "        indices    : List of indices to use from the dataset\n",
    "        transform  : torchvision transforms to apply\n",
    "    \"\"\"\n",
    "    def __init__(self, hf_dataset, indices, transform=None):\n",
    "        self.dataset   = hf_dataset\n",
    "        self.indices   = indices\n",
    "        self.transform = transform\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.indices)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        real_idx = self.indices[idx]\n",
    "        sample   = self.dataset[real_idx]\n",
    "\n",
    "        image = sample['image']\n",
    "        label = sample['label']\n",
    "\n",
    "        # Ensure PIL Image in RGB\n",
    "        if not isinstance(image, Image.Image):\n",
    "            image = Image.fromarray(image)\n",
    "        image = image.convert('RGB')\n",
    "\n",
    "        if self.transform:\n",
    "            image = self.transform(image)\n",
    "\n",
    "        return image, torch.tensor(label, dtype=torch.long)\n",
    "\n",
    "\n",
    "# ── Create Datasets ───────────────────────────────────────────────\n",
    "train_dataset = ColonDataset(colon_ds, train_idx, transform=train_transform)\n",
    "val_dataset   = ColonDataset(colon_ds, val_idx,   transform=val_transform)\n",
    "test_dataset  = ColonDataset(colon_ds, test_idx,  transform=val_transform)\n",
    "\n",
    "# ── Create DataLoaders ────────────────────────────────────────────\n",
    "train_loader = DataLoader(\n",
    "    train_dataset,\n",
    "    batch_size=CONFIG['batch_size'],\n",
    "    shuffle=True,\n",
    "    num_workers=2,\n",
    "    pin_memory=True,\n",
    ")\n",
    "val_loader = DataLoader(\n",
    "    val_dataset,\n",
    "    batch_size=CONFIG['batch_size'],\n",
    "    shuffle=False,\n",
    "    num_workers=2,\n",
    "    pin_memory=True,\n",
    ")\n",
    "test_loader = DataLoader(\n",
    "    test_dataset,\n",
    "    batch_size=CONFIG['batch_size'],\n",
    "    shuffle=False,\n",
    "    num_workers=2,\n",
    "    pin_memory=True,\n",
    ")\n",
    "\n",
    "print(f'Train batches : {len(train_loader)}')\n",
    "print(f'Val batches   : {len(val_loader)}')\n",
    "print(f'Test batches  : {len(test_loader)}')\n",
    "\n",
    "# Verify a batch\n",
    "images, labels = next(iter(train_loader))\n",
    "print(f'\\nBatch shape : {images.shape}')  # (32, 3, 224, 224)\n",
    "print(f'Labels      : {labels[:8].tolist()}')"
   ]
  },
